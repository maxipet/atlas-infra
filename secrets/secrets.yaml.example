# Copy to a temporary local file, replace every value, then encrypt it with sops.
# Never commit a plaintext version of this file.
ionos_dns_env: |
  IONOS_API_KEY=replace-with-ionos-api-key
smtp_password: replace-with-ionos-mailbox-password
owncloud_admin_password: replace-with-owncloud-admin-password
owncloud_db_password: replace-with-owncloud-database-password
mariadb_root_password: replace-with-mariadb-root-password
vaultwarden_admin_token: replace-with-argon2-phc-token
vaultwarden_backup_password: replace-with-long-random-backup-password
n8n_db_password: replace-with-64-character-hex-value
n8n_encryption_key: replace-with-64-character-hex-value
n8n_runners_auth_token: replace-with-64-character-hex-value
